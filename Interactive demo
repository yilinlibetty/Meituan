/* scoring */
function scoreAct(a,day){
 if(!a.days.includes(day))return null;
 const C=S.C,w=getWx(day);let s=55;const r=[];
 if(C.exclude.includes(a.cat)){s-=40;r.push(['warn','你说不想去'+a.cat])}
 else if(C.interests.includes(a.cat)){s+=18;r.push(['good','你想玩的'+a.cat])}
 if(C.indoor&&!a.indoor){s-=35;r.push(['warn','你想待在室内'])}
 if(w.type==='rain'){if(a.indoor){s+=12;r.push(['good','下雨也不受影响'])}else{s-=30;r.push(['warn','当天有雨'])}}
 else if(w.type==='hot'){if(a.indoor){s+=6;r.push(['good','室内避暑'])}else if(a.slots.every(x=>x==='eve')){s+=4;r.push(['good','晚上凉快'])}else{s-=18;r.push(['warn',`最高 ${w.hi}°，白天偏热`])}}
 else if(!a.indoor&&!C.indoor){s+=10;r.push(['good',w.type==='sun'?'晴天适合户外':'多云不晒'])}
 if(a.cost===0){s+=8+(C.free?6:0);r.push(['good','免费'])}
 else if(a.cost<=C.budget){s+=6;r.push(['good',`人均 ¥${a.cost}`])}
 else{s-=25;r.push(['warn',`超预算 ¥${a.cost-C.budget}`])}
 const n=C.people;
 if(n<a.ppl[0]){s-=12;r.push(['warn',`${a.ppl[0]} 人起，可以组队凑人`])}
 else if(n>a.ppl[1]){s-=12;r.push(['warn',`建议 ${a.ppl[1]} 人以内`])}
 else if(n>=3&&a.group){s+=8;r.push(['good',`${n} 个人一起更好玩`])}
 else if(n===1&&a.solo){s+=6;r.push(['good','一个人去也自在'])}
 if(C.photo&&a.photo){s+=10;r.push(['good','拍照出片'])}
 if(C.easy){if(a.tiring){s-=18;r.push(['warn','有点累'])}else if(a.dur<=2.5){s+=5;r.push(['good','轻松不累'])}}
 if(C.quiet){if(a.lively){s-=12;r.push(['warn','人多偏吵'])}else if(a.quiet){s+=8;r.push(['good','人少安静'])}}
 if(C.lively&&a.lively){s+=8;r.push(['good','热闹好玩'])}
 if(C.evening&&a.slots.includes('eve')){s+=6;r.push(['good','晚上能玩'])}
 const m=travel(a);
 if(m>C.maxTravel){s-=12;r.push(['warn',`单程约 ${m} 分钟`])}else if(m<=30){s+=4;r.push(['good','离学校近'])}
 if(C.dur==='half'&&a.dur>=5){s-=10;r.push(['warn','要花一整天'])}
 return{s:Math.max(1,Math.min(99,Math.round(s))),r,m}}
function ranked(day){return ACTS.map(a=>{const x=scoreAct(a,day);return x&&{a,...x}}).filter(Boolean).sort((p,q)=>q.s-p.s)}
function autoRoute(day,seed){
 const scored=ranked(day),C=S.C,full=C.dur==='full';const slots=full?['am','pm','eve']:['pm','eve'];
 let remain=C.budget;const used=new Set(),cats=new Set(),filled=new Set(),stops=[];
 slots.forEach((sl,i)=>{if(filled.has(sl))return;
  const wet=getWx(day).type==='rain'||C.indoor;
  let cand=scored.filter(x=>x.s>=45&&!used.has(x.a.id)&&x.a.cost<=remain&&(!wet||x.a.indoor)&&(x.a.slots.includes(sl)||(sl==='am'&&full&&x.a.slots.includes('day'))));
  if(!cand.length)return;
  cand=cand.map(x=>({...x,k:x.s-(cats.has(x.a.cat)?15:0)})).sort((p,q)=>q.k-p.k);
  const pick=cand[seed?((seed+i)%Math.min(3,cand.length)):0];
  used.add(pick.a.id);cats.add(pick.a.cat);remain-=pick.a.cost;
  if(pick.a.slots.includes('day')){filled.add('pm');stops.push({id:pick.a.id,time:SLOT_T.day,slot:'day'})}else stops.push({id:pick.a.id,time:SLOT_T[sl],slot:sl})});
 return stops}
function currentRoute(day){
 const p=S.plan[day];if(p)return{src:p.src,title:p.title,stops:p.stops.map(([id,time,note])=>({id,time,note}))};
 const stops=autoRoute(day,S.seed);return{src:'auto',title:planTitle(day,stops),stops}}
function planTitle(day,stops){const C=S.C,w=getWx(day),p=[];
 if(C.indoor||w.type==='rain')p.push('雨天室内');if(C.photo)p.push('出片');if(C.easy)p.push('不累');if(C.free||C.budget<=30)p.push('零元');if(C.quiet)p.push('安静');if(C.lively)p.push('热闹');if(C.evening&&p.length<2)p.push('夜游');
 if(p.length)return `${dayName(day)} · ${p.slice(0,2).join('又')}的一天`;
 return stops.length?stops.map(s=>A[s.id].cat).join(' + '):`${dayName(day)}路线`}
function checklist(t){const a=A[t.act],w=getWx(t.day);const L=[];if(w.type==='rain')L.push('雨伞');L.push('学生证','交通卡或乘车码','充电宝');if(!a.indoor&&(w.type==='sun'||w.type==='hot'))L.push('防晒和水');if(a.cat==='户外')L.push('运动鞋');return L}
function earned(){return BADGES.filter(b=>b.f(S.checks)>=b.n).map(b=>b.t)}
function condLabels(withDay){const C=S.C,L=[];if(withDay)L.push(dayName(S.day));L.push(pplLabel(C.people),`人均 ¥${C.budget} 内`,`${C.campus}出发`);
 if(C.maxTravel!==60)L.push(C.maxTravel<60?'别太远':'远点也行');if(C.dur==='half')L.push('只玩半天');
 C.interests.forEach(i=>L.push(i));if(C.photo)L.push('想拍照');if(C.easy)L.push('不想太累');if(C.quiet)L.push('人少安静');if(C.lively)L.push('要热闹');if(C.indoor)L.push('只去室内');if(C.evening)L.push('晚上也玩');C.exclude.forEach(x=>L.push('不去'+x));return L}

