<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="周末出逃：跟 AI 说一句话，按天气、预算和同行人数排好上海周末路线，支持组队出发、打卡点亮地图和攻略分享。">
<title>周末出逃</title>
<style>
:root{
  --page:#E8EAF0;--bg:#F3F4F8;--surface:#FFFFFF;--surface2:#F0F1F5;--line:#E3E5EB;--line2:#CDD1DA;
  --ink:#101218;--ink2:#3A3F4B;--muted:#7A8090;
  --hot:#FF5B2E;--hot-soft:#FFE9E1;--hot-ink:#D8401A;
  --ai:#3D5AFE;--ai-soft:#E7EBFF;--ai-ink:#2B44D6;
  --lime:#D6F36A;--lime-ink:#26300A;
  --good:#0F9F6A;--good-soft:#DCF5EA;--warn:#C45E0C;--warn-soft:#FFEEDC;
  --route:#15171D;--route2:#23262F;--route-line:#343844;
  --on:#FFFFFF;--bezel:#0B0C10;--scrim:rgba(8,10,16,.45);
  --shadow:0 1px 2px rgba(16,18,24,.04),0 8px 22px rgba(16,18,24,.07);
  --av-l:88%;--av-t:30%;--glow1:rgba(214,243,106,.5);--glow2:rgba(61,90,254,.13);--sea:#D9E4FF;--land:#F6F7FA;--lime2:#B9E33F;
  --font:"PingFang SC","HarmonyOS Sans SC","MiSans","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --page:#06070A;--bg:#0D0E12;--surface:#17191F;--surface2:#20232B;--line:#2A2D36;--line2:#3A3E49;
  --ink:#F2F3F6;--ink2:#C9CCD4;--muted:#8C92A0;
  --hot:#FF6A3D;--hot-soft:#3A1E15;--hot-ink:#FF9B7A;
  --ai:#6078FF;--ai-soft:#1C2247;--ai-ink:#AAB7FF;
  --good:#3DD39A;--good-soft:#12332A;--warn:#F2A55A;--warn-soft:#3A2915;
  --route:#1E2129;--route2:#2A2E38;--route-line:#3A3F4B;
  --bezel:#000;--scrim:rgba(0,0,0,.6);--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 22px rgba(0,0,0,.3);
  --av-l:28%;--av-t:84%;--glow1:rgba(214,243,106,.09);--glow2:rgba(96,120,255,.16);--sea:#111A30;--land:#20242F;color-scheme:dark}}
:root[data-theme="dark"]{
  --page:#06070A;--bg:#0D0E12;--surface:#17191F;--surface2:#20232B;--line:#2A2D36;--line2:#3A3E49;
  --ink:#F2F3F6;--ink2:#C9CCD4;--muted:#8C92A0;
  --hot:#FF6A3D;--hot-soft:#3A1E15;--hot-ink:#FF9B7A;
  --ai:#6078FF;--ai-soft:#1C2247;--ai-ink:#AAB7FF;
  --good:#3DD39A;--good-soft:#12332A;--warn:#F2A55A;--warn-soft:#3A2915;
  --route:#1E2129;--route2:#2A2E38;--route-line:#3A3F4B;
  --bezel:#000;--scrim:rgba(0,0,0,.6);--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 22px rgba(0,0,0,.3);
  --av-l:28%;--av-t:84%;--glow1:rgba(214,243,106,.09);--glow2:rgba(96,120,255,.16);--sea:#111A30;--land:#20242F;color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--page);color:var(--ink);font-family:var(--font);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2.5px solid var(--ai);outline-offset:2px}
.num{font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}
.small{font-size:12.5px}
h1,h2,h3,h4,h5{margin:0;text-wrap:balance}

/* stage */
.stage{height:100%}
.notes{display:none}
.device{height:100%;position:relative;overflow:hidden}
.sbar{display:none}
.app{height:100%;display:flex;flex-direction:column;background:radial-gradient(100% 36% at 100% 0%,var(--glow1),transparent 72%),radial-gradient(80% 30% at 0% 0%,var(--glow2),transparent 72%),var(--bg);position:relative;overflow:hidden}
@media (min-width:520px){
  .stage{display:flex;justify-content:center;align-items:center;gap:64px;padding:24px 16px;min-height:100%;height:auto}
  .device{flex:none;width:394px;height:min(860px,calc(100vh - 48px));min-height:600px;border:11px solid var(--bezel);border-radius:50px;box-shadow:0 30px 80px rgba(16,18,24,.22)}
  .app{border-radius:39px}
  .sbar{display:flex;justify-content:space-between;align-items:center;padding:11px 28px 0;font-size:13px;font-weight:700;flex:none}
}
@media (min-width:1000px){
  .notes{display:block;width:470px;max-height:calc(100vh - 48px);overflow-y:auto;padding-right:10px}
  .notes-btn{display:none!important}
}

/* notes */
.nc{color:var(--ink2);font-size:14.5px;line-height:1.75}
.nc .eyebrow{font-size:12px;color:var(--muted);letter-spacing:.1em;font-weight:600}
.nc h1{font-size:48px;line-height:1.05;color:var(--ink);font-weight:900;letter-spacing:.01em;display:flex;align-items:center;gap:4px;margin:8px 0 14px}
.nc h2{font-size:16px;color:var(--ink);margin:28px 0 8px;font-weight:800}
.nc p{margin:0 0 8px;max-width:62ch}
.nc ul,.nc ol{margin:0;padding-left:1.2em}
.nc li{margin:3px 0}
.nc .pt{border-top:1px solid var(--line)}
.nc .pt div{display:grid;grid-template-columns:10em 1fr;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px;line-height:1.6}
.nc .pt b{color:var(--ink);font-weight:700}
.nc .fine{font-size:12.5px;color:var(--muted);margin-top:24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.nc .try{background:var(--ai-soft);border-radius:16px;padding:12px 16px 12px 30px;color:var(--ink2)}

/* brand + header */
.logo{display:inline-flex;align-items:center;font-weight:900;letter-spacing:.02em}
.logo i{font-style:normal;display:inline-grid;place-items:center;background:var(--hot);color:#fff;border-radius:9px;transform:rotate(-8deg);margin-left:3px;width:1.3em;height:1.3em;font-size:.95em;box-shadow:2px 2px 0 var(--ink)}
.nc h1 .logo i{border-radius:14px;box-shadow:4px 4px 0 var(--ink)}
.top{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 6px;flex:none;gap:10px}
.top .logo{font-size:19px}
.top-r{display:flex;align-items:center;gap:8px}
.city{display:flex;align-items:center;gap:3px;font-size:13px;font-weight:700;background:var(--surface);border-radius:999px;padding:5px 10px;box-shadow:var(--shadow)}
.city svg{width:14px;height:14px}
.notes-btn{border:0;background:var(--ink);color:var(--bg);border-radius:999px;padding:6px 11px;font-size:12px;font-weight:700}

.screen{flex:1;overflow-y:auto;padding:6px 16px 118px;display:flex;flex-direction:column;gap:14px;overscroll-behavior:contain;scroll-behavior:auto}
.screen>*{flex:none}
.screen.chatmode{padding-bottom:210px;gap:12px}

/* floating tab bar */
.tabbar{position:absolute;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));height:64px;background:var(--surface);border-radius:24px;box-shadow:0 10px 30px rgba(16,18,24,.16),0 0 0 1px var(--line);display:grid;grid-template-columns:1fr 1fr 76px 1fr 1fr;align-items:center;z-index:20}
.tabbar button{border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:1px;font-size:11px;color:var(--muted);padding:6px 0;font-weight:600}
.tabbar svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.tabbar button.on{color:var(--ink)}
.tabbar button.on svg{stroke-width:2.4}
.tabbar .aib{position:relative;top:-14px}
.tabbar .aib span{width:58px;height:58px;border-radius:20px;background:var(--ai);color:#fff;display:grid;place-items:center;box-shadow:0 8px 20px rgba(61,90,254,.4);transform:rotate(-6deg);transition:transform .2s}
.tabbar .aib svg{fill:currentColor;stroke:none;width:28px;height:28px;transform:rotate(6deg)}
.tabbar .aib.on span{background:var(--ink);color:var(--lime);transform:rotate(0)}
.tabbar .aib.on svg{transform:none}
.tabbar .aib em{font-style:normal;font-size:11px;color:var(--ai);font-weight:800;margin-top:4px}
.fab{position:absolute;right:16px;bottom:calc(92px + env(safe-area-inset-bottom,0px));border:0;background:var(--hot);color:#fff;border-radius:999px;padding:12px 18px;font-weight:800;box-shadow:0 8px 20px rgba(255,91,46,.4);z-index:15}

/* generic */
.sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:4px}
.sec-h h3{font-size:19px;font-weight:900}
.btn{border:0;border-radius:999px;padding:11px 16px;font-weight:800;font-size:14px}
.btn.primary{background:var(--hot);color:#fff}
.btn.ai{background:var(--ai);color:#fff}
.btn.lime{background:var(--lime);color:var(--lime-ink)}
.btn.ghost{background:var(--surface2);color:var(--ink)}
.btn.dark{background:var(--ink);color:var(--bg)}
.btn.sm{padding:7px 13px;font-size:12.5px}
.btn.block{width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed}
.lnk{border:0;background:none;color:var(--ai);font-weight:800;padding:0;font-size:12.5px}
.chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.chips::-webkit-scrollbar{display:none}
.chips.wrap{flex-wrap:wrap;overflow:visible}
.chip{flex:none;border:0;background:var(--surface);color:var(--ink2);border-radius:999px;padding:7px 14px;font-size:13px;font-weight:600;box-shadow:inset 0 0 0 1px var(--line)}
.chip.on{background:var(--ink);color:var(--bg);box-shadow:none}
.seg{display:flex;background:var(--surface2);border-radius:14px;padding:4px;gap:4px}
.seg button{flex:1;border:0;background:transparent;padding:8px 4px;border-radius:10px;font-size:13px;color:var(--muted);white-space:nowrap;font-weight:700}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.1)}
.ln{display:inline-grid;place-items:center;min-width:18px;height:17px;padding:0 4px;border-radius:5px;font-size:10.5px;font-weight:800;background:var(--lc);color:var(--lt);margin-right:2px;line-height:1}
.meta{display:flex;flex-wrap:wrap;align-items:center;gap:3px;font-size:12px;color:var(--muted)}
.av{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:hsl(var(--h) 70% var(--av-l));color:hsl(var(--h) 55% var(--av-t));font-size:12px;font-weight:800;flex:none}
.av.sm{width:20px;height:20px;font-size:10px}
.empty{text-align:center;padding:28px 12px;color:var(--muted);display:flex;flex-direction:column;gap:10px;align-items:center}
.tag{font-size:11.5px;background:var(--surface2);color:var(--ink2);border-radius:999px;padding:2px 9px;font-weight:600}
.tag.aa{background:var(--lime);color:var(--lime-ink)}
.r{font-size:11.5px;padding:2px 9px;border-radius:999px;line-height:1.6;font-weight:600}
.r.good{background:var(--good-soft);color:var(--good)}
.r.warn{background:var(--warn-soft);color:var(--warn)}

/* photo */
.ph{position:relative;overflow:hidden;background:linear-gradient(140deg,var(--c),color-mix(in srgb,var(--c) 45%,#000));flex:none}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.ph .fb{position:absolute;inset:0;display:grid;place-items:center;font-size:40px;font-weight:900;color:rgba(255,255,255,.35)}
.ph.shade::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 35%,rgba(0,0,0,.72))}

/* home */
.hello{display:flex;justify-content:space-between;align-items:flex-end;gap:10px}
.hello h2{font-size:27px;font-weight:900;line-height:1.15;letter-spacing:.01em}
.hello h2 em{font-style:normal;background:linear-gradient(transparent 58%,var(--lime) 58%);padding:0 2px}
.hello p{margin:4px 0 0;color:var(--muted);font-size:13px}
.aicard{background:linear-gradient(165deg,rgba(61,90,254,.95) 30%,rgba(61,90,254,.72)),var(--hero,none) center 60%/cover,var(--ai);color:#fff;border-radius:26px;padding:16px;position:relative;overflow:hidden;display:flex;flex-direction:column;gap:12px}
.aicard::before{content:"";position:absolute;right:-40px;top:-50px;width:150px;height:150px;border-radius:50%;background:rgba(255,255,255,.12)}
.aicard .lab{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:800;letter-spacing:.06em;position:relative}
.aicard .lab svg{width:16px;height:16px;fill:var(--lime)}
.aicard h3{font-size:20px;font-weight:900;line-height:1.3;position:relative}
.aiinput{display:flex;align-items:center;gap:8px;background:#fff;border-radius:18px;padding:6px 6px 6px 14px;position:relative}
.aiinput input{flex:1;min-width:0;border:0;outline:0;background:none;color:#101218;font-size:14px;padding:6px 0}
.aiinput input::placeholder{color:#8C92A0}
.aiinput button{border:0;width:38px;height:38px;border-radius:14px;background:var(--lime);color:var(--lime-ink);display:grid;place-items:center;flex:none}
.aiinput svg{width:20px;height:20px}
.aicard .chips{position:relative}
.aicard .chip{background:rgba(255,255,255,.16);color:#fff;box-shadow:none;font-size:12.5px;padding:6px 12px}
.days{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.dayb{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:20px;border:0;background:var(--surface);text-align:left;box-shadow:var(--shadow)}
.dayb b{font-size:16px;font-weight:900;display:block;line-height:1.2}
.dayb span{font-size:12px;color:var(--muted);white-space:nowrap}.dayb>span{min-width:0}
.dayb i{margin-left:auto;width:30px;height:30px;display:grid}
.dayb.on{background:var(--ink)}
.dayb.on b{color:var(--bg)}.dayb.on span{color:var(--line2)}
.wx-sun{color:#FFB300}.wx-hot{color:#FF5B2E}.wx-cloud{color:#9AA9B8}.wx-rain{color:#4C8DFF}
.wxrow{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:-4px}
.wxrow .tip{flex-basis:100%;color:var(--ink2);font-weight:600}
.mini{border:0;background:var(--surface);border-radius:999px;padding:3px 10px;font-size:12px;color:var(--ink2);font-weight:600;box-shadow:inset 0 0 0 1px var(--line)}
.mini.on{background:var(--lime);color:var(--lime-ink);box-shadow:none}
.mem{background:var(--surface);border-radius:22px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;box-shadow:var(--shadow)}
.mem-h{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;font-weight:800;color:var(--ink2)}
.mem-h span{display:flex;align-items:center;gap:5px}
.mem-h svg{width:14px;height:14px;fill:var(--ai)}
.mchip{display:inline-flex;align-items:center;gap:4px;background:var(--ai-soft);color:var(--ai-ink);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:700;border:0}
.mchip b{font-weight:900;opacity:.6}
.route{background:var(--route);color:#fff;border-radius:26px;padding:16px;display:flex;flex-direction:column;gap:12px}
.route-h{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.route .eb{font-size:11.5px;font-weight:800;letter-spacing:.05em;color:var(--lime)}
.route h3{font-size:18px;font-weight:900;margin-top:2px;line-height:1.3}
.route-cost{text-align:right;flex:none}
.route-cost b{font-size:26px;font-weight:900;display:block;line-height:1.1;color:var(--lime)}
.route-cost span{font-size:11px;color:#A6ABB8}
.strip{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:8px}
.strip .ph{height:84px;border-radius:16px}
.strip .t{position:absolute;left:8px;bottom:6px;z-index:2;font-size:12px;font-weight:900;color:#fff}
.stops{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.stops li{display:grid;grid-template-columns:44px 1fr auto;gap:8px;align-items:center;cursor:pointer}
.stops time{font-size:12.5px;font-weight:800;color:#A6ABB8}
.stops b{font-size:14px;font-weight:800;display:block;line-height:1.35}
.stops .meta{color:#A6ABB8}
.stops .pr{font-size:12.5px;font-weight:800;color:#fff}
.route-a{display:flex;gap:8px}
.route-a .btn{flex:1}
.route .btn.ghost{background:var(--route2);color:#fff}
.acts{display:flex;flex-direction:column;gap:14px}
.rc{background:var(--surface);border-radius:24px;overflow:hidden;cursor:pointer;box-shadow:var(--shadow)}
.rc .ph{height:158px}
.rc .ov{position:absolute;inset:auto 14px 12px 14px;z-index:2;color:#fff}
.rc .ov h4{font-size:17px;font-weight:900;line-height:1.3;text-shadow:0 1px 8px rgba(0,0,0,.3)}
.rc .ov .meta{color:rgba(255,255,255,.88)}
.score{position:absolute;left:12px;top:12px;z-index:2;background:var(--lime);color:var(--lime-ink);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:900}
.score.mid{background:#fff;color:#101218}
.score.lo{background:#FFE2C9;color:#8A3D00}
.price{position:absolute;right:12px;top:12px;z-index:2;background:rgba(16,18,24,.55);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#fff;border-radius:999px;padding:3px 10px;font-size:12.5px;font-weight:800}
.rc .rs{display:flex;flex-wrap:wrap;gap:5px;padding:11px 14px 13px}

/* home list */
.cats{display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:4px 4px 2px;margin:0 -4px}
.cats::-webkit-scrollbar{display:none}
.cat{flex:none;border:0;background:none;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--ink2);padding:0}
.cat .ph{width:58px;height:58px;border-radius:20px;box-shadow:0 0 0 2px var(--bg)}
.cat .ph .fb{font-size:20px}
.cat.all .ph{background:var(--ink);color:var(--lime);display:grid;place-items:center}
.cat.all .ph svg{width:26px;height:26px;fill:currentColor}
.cat.on{color:var(--ink);font-weight:900}
.cat.on .ph{box-shadow:0 0 0 2px var(--bg),0 0 0 4.5px var(--hot)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.gi{background:var(--surface);border-radius:20px;overflow:hidden;cursor:pointer;box-shadow:var(--shadow);display:flex;flex-direction:column;min-width:0}
.gi .ph{height:132px}
.gi .score{left:8px;top:8px;font-size:11px;padding:2px 8px}
.ctag{position:absolute;left:8px;bottom:8px;z-index:2;background:rgba(255,255,255,.94);color:#101218;border-radius:999px;padding:1px 8px;font-size:11px;font-weight:800}
.gi-b{padding:9px 11px 11px;display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}
.gi-b h4{font-size:14px;font-weight:800;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.gi-b .meta{flex-wrap:nowrap;white-space:nowrap;overflow:hidden;min-width:0}.gi-b .meta span:last-child{overflow:hidden;text-overflow:ellipsis;min-width:0}
.gi-f{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-top:auto;padding-top:3px;min-width:0}
.gi-f b{font-size:15px;font-weight:900;color:var(--hot);flex:none}
.gi-f span{font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.gi-f .good{color:var(--good)}.gi-f .warn{color:var(--warn)}
.best{position:absolute;right:12px;bottom:12px;z-index:2;background:var(--hot);color:#fff;border-radius:999px;padding:2px 10px;font-size:11.5px;font-weight:900}

/* map */
.mapcard{background:var(--surface);border-radius:24px;padding:14px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:10px}
.map-h{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.map-h h3{font-size:19px;font-weight:900}
.seg.sm{padding:3px;border-radius:12px;flex:none}
.seg.sm button{padding:5px 11px;font-size:12px;flex:none}
.mapbox{background:var(--sea);border-radius:18px;overflow:hidden;aspect-ratio:1/1;width:100%;position:relative}
.mapbox svg{width:100%;height:100%;display:block}
.dist{fill:var(--land);stroke:var(--line2);stroke-width:1.2;vector-effect:non-scaling-stroke;cursor:pointer;transition:fill .2s}
.dist:hover{fill:var(--ai-soft)}
.dist.lit{fill:var(--lime);stroke:#93BA17}
.dist.lit2{fill:var(--lime2)}
